{
  "name": "dekopon-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:views": "node --test scripts/check-views.mjs",
    "check:seed": "node --test scripts/check-seed.mjs",
    "check:cedar": "node --test scripts/check-cedar.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
